// AI WhatsApp Legal Assistant — database schema (Phase 3)
//
// Two schemas (D-001):
//   platform — cross-tenant infrastructure: tenant registry, webhook inbox,
//              outbox, permission catalog, prompt registry. NO RLS here;
//              access is restricted to privileged roles and infrastructure
//              code paths only (never request-scoped tenant queries).
//   app      — every tenant-owned table. Each carries tenantId; RLS with
//              FORCE is applied in migration 0002 (Prisma can't express it).
//
// Prisma can't express: RLS policies, table partitioning, exclusion
// constraints, vector indexes, partial unique indexes. Those live in
// hand-written migrations 0002/0003 — see docs/phases/phase-03-database-design.md.

// Prisma 7: Rust-free client via query compiler + driver adapter
// (@prisma/adapter-pg). `prisma-client-js` is superseded — do not revert.
generator client {
  provider     = "prisma-client"
  // Inside src/ so tsc's rootDir stays src/ and dist mirrors it 1:1.
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// Prisma 7: connection URLs live in prisma.config.ts, not the schema file.
// Migrations use MIGRATION_DATABASE_URL (owner role); the app uses
// DATABASE_URL (non-owner app_user, RLS-bound) via @prisma/adapter-pg.
datasource db {
  provider = "postgresql"
  schemas  = ["app", "platform"]
}

