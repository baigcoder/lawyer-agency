model Document {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String     @db.Uuid
  caseId           String?    @db.Uuid
  clientId         String     @db.Uuid
  messageId        String?    @db.Uuid // provenance (FR-DOC-04)
  storagePath      String // tenant-scoped path in Supabase Storage
  filename         String
  description      String?
  mimeType         String
  sizeBytes        Int
  docType          DocType    @default(OTHER)
  ocrStatus        OcrStatus  @default(PENDING)
  // surfaced in UI; low-confidence extraction is never auto-applied (J4/R4)
  ocrConfidence    Float?
  extractedText    String? // full plain-text extraction for search/AI context
  extractedFields  Json       @default("{}")
  scanStatus       ScanStatus @default(PENDING)
  isPinned         Boolean    @default(false)
  version          Int        @default(1)
  deletedAt        DateTime?  @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @db.Timestamptz(6)

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  case    Case?           @relation(fields: [caseId], references: [id])
  client  Client          @relation(fields: [clientId], references: [id])
  chunks  DocumentChunk[]

  @@index([tenantId, caseId])
  @@index([tenantId, clientId])
  @@index([tenantId, isPinned])
  @@map("documents")
  @@schema("app")
}

