/**
 * Phase 3 connection state machine (D-092). Drives the dashboard go-live
 * checklist and the /v1/whatsapp/health surface. Transitions are mediated
 * by OnboardingService; LIVE is only reachable via an explicit admin go-live
 * gate once READY_TO_GO_LIVE + approved templates are confirmed.
 */
enum ConnectionStage {
  OFFICIAL_CONNECT_STARTED
  META_PENDING_VERIFICATION
  NUMBER_VERIFIED
  TEMPLATES_PENDING
  READY_TO_GO_LIVE
  LIVE
  PAUSED
  REJECTED
  DISCONNECTED

  @@schema("app")
}

enum PilotSessionStatus {
  PAIRING
  PAIRED
  EXPIRED
  DISCONNECTED

  @@schema("app")
}

enum TemplateStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAUSED

  @@schema("app")
}

enum TemplateCategory {
  UTILITY
  AUTHENTICATION
  SERVICE
  // MARKETING intentionally absent — PBC solicitation risk (D-005)

  @@schema("app")
}

enum ActorType {
  USER
  SYSTEM
  PLATFORM_ADMIN
  AI

  @@schema("app")
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  DUPLICATE
  IGNORED

  @@schema("platform")
}

// ---------------------------------------------------------------------------
// platform schema — cross-tenant infrastructure
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  // Clerk organization id that maps to this tenant (D-017)
  clerkOrgId String? @unique
  status    TenantStatus @default(TRIAL)
  // practice areas, working hours, consult fee, escalation chain, locale prefs
  settings  Json     @default("{}")
  // D-005: tighten-only provider allow-list; empty = platform default set
  aiProviderAllowlist String[] @default([])
  // FR-AI-11: monthly AI budget cap in USD micros (null = platform default)
  aiMonthlyBudgetMicros Int?
  // NFR-RET-01: per-tenant stricter retention override (days; null = default)
  retentionDaysOverride Int?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  roles              Role[]
  users              User[]
  lawyers            Lawyer[]
  lawyerCalendars    LawyerCalendar[]
  lawyerAvailability LawyerAvailability[]
  lawyerCaseHighlights LawyerCaseHighlight[]
  clients            Client[]
  cases              Case[]
  caseLawyers        CaseLawyer[]
  conversations      Conversation[]
  messages           Message[]
  intakeSessions     IntakeSession[]
  escalations        Escalation[]
  documents          Document[]
  documentChunks     DocumentChunk[]
  documentRequests   DocumentRequest[]
  appointments       Appointment[]
  payments           Payment[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  aiLogs             AiLog[]
  promptLogs         PromptLog[]
  knowledgeBase      KnowledgeBase[]
  kbChunks           KbChunk[]
  whatsappAccounts   WhatsappAccount[]
  whatsappConnections WhatsappConnection[]
  whatsappTemplates  WhatsappTemplate[]
  pilotSessions      PilotSession[]
  outboxEvents       OutboxEvent[]
  webhookEvents      WebhookEvent[]
  waRoutes           WaRoute[]
  pushSubscriptions  PushSubscription[]
  analyticsDaily     AnalyticsDaily[]
  features           TenantFeature[]
  firmPaymentDetails FirmPaymentDetails?
  courtHearings      CourtHearing[]
  conversationNotes  ConversationNote[]
  voiceCalls         VoiceCall[]

  @@map("tenants")
  @@schema("platform")
}

model PlatformUser {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId String   @unique
  email       String
  name        String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@map("platform_users")
  @@schema("platform")
}

// Platform-owned permission catalog; tenants bind permissions to their roles.
model Permission {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String @unique // e.g. "case:read", "payment:refund"
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
  @@schema("platform")
}

// Platform-owned prompt registry. Versioned so every ai_log/prompt_log pins
// the exact prompt that produced it (FR-AI-10).
model PromptVersion {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent        String // e.g. "intake", "classification", "faq"
  version      Int
  template     String
  // sha256 of template — cheap integrity check in logs without storing T2 I/O
  templateHash String
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  aiLogs     AiLog[]
  promptLogs PromptLog[]

  @@unique([agent, version])
  @@map("prompt_versions")
  @@schema("platform")
}

// Inbound webhook inbox — the idempotency anchor for the whole platform
// (ADR-004). Unique externalEventId makes Meta retries safe. Raw payloads may
// contain T2/T3 data: access restricted to the WhatsApp module; payload is
// nulled after successful processing (retention trim, Phase 6).
model WebhookEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String?  @db.Uuid // resolved via phone_number_id; null pre-resolution
  provider        String   @default("meta")
  externalEventId String   @unique
  phoneNumberId   String?
  payload         Json?
  status          WebhookEventStatus @default(RECEIVED)
  error           String?
  receivedAt      DateTime @default(now()) @db.Timestamptz(6)
  processedAt     DateTime? @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([status, receivedAt])
  @@map("webhook_events")
  @@schema("platform")
}

// Transactional outbox (ADR-003): written in the same transaction as the
// state change; dispatcher publishes to BullMQ; consumers dedupe on event id.
model OutboxEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @db.Uuid
  type        String // e.g. "case.created", "payment.succeeded"
  payload     Json // classified T1/T2 only — n8n never receives T3 (D-005)
  occurredAt  DateTime  @default(now()) @db.Timestamptz(6)
  publishedAt DateTime? @db.Timestamptz(6)
  attempts    Int       @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([publishedAt, occurredAt])
  @@map("outbox_events")
  @@schema("platform")
}

// Pre-tenant routing (D-040): inbound webhooks carry only Meta's
// phone_number_id; this maps it to a tenant before any RLS-scoped work.
// Written at WABA onboarding (6b); read on every webhook.
model WaRoute {
  phoneNumberId String   @id
  tenantId      String   @db.Uuid
  wabaId        String
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("wa_routes")
  @@schema("platform")
}

// Platform-level feature entitlements. Gates paid capabilities like the
// official WhatsApp Business API connection; kept in platform schema because
// it represents a cross-tenant billing decision, not tenant-owned data.
model TenantFeature {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String             @db.Uuid
  code      TenantFeatureCode
  status    TenantFeatureStatus @default(INACTIVE)
  expiresAt DateTime?          @db.Timestamptz(6)
  metadata  Json               @default("{}")
  createdAt DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("tenant_features")
  @@schema("platform")
}

// ---------------------------------------------------------------------------
// app schema — tenant-owned (RLS enforced in migration 0002)
// ---------------------------------------------------------------------------

model Role {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String  @db.Uuid
  name      String // Firm Admin / Lawyer / Staff / Read-only (+ custom)
  isSystem  Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  users           User[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
  @@schema("app")
}

model RolePermission {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([tenantId])
  @@map("role_permissions")
  @@schema("app")
}

model User {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String     @db.Uuid
  clerkUserId String     @unique
  roleId      String     @db.Uuid
  name        String
  email       String
  phone       String?
  // Phase 12: per-user notification channel preferences, e.g.
  // { "DASHBOARD": true, "WEB_PUSH": true, "WHATSAPP_TEMPLATE": false, "EMAIL_DIGEST": true }
  notificationPrefs Json @default("{}")
  status      UserStatus @default(INVITED)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  role          Role           @relation(fields: [roleId], references: [id])
  lawyer        Lawyer?
  assignedConversations Conversation[]
  sentMessages  Message[]
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  recordedPayments Payment[]
  conversationNotes ConversationNote[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@map("users")
  @@schema("app")
}

model Lawyer {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String   @db.Uuid
  userId               String   @unique @db.Uuid
  practiceAreas        String[] @default([])
  whatsappNumber       String?
  bio                  String?
  bioUr                String?
  yearsExperience      Int?
  barCouncil           String?
  barEnrollmentNumber  String?
  education            String[] @default([])
  achievements         String[] @default([])
  languages            String[] @default([])
  profileCompletedAt   DateTime? @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)

  tenant                  Tenant               @relation(fields: [tenantId], references: [id])
  user                    User                 @relation(fields: [userId], references: [id])
  availability            LawyerAvailability[]
  caseLawyers             CaseLawyer[]
  appointments            Appointment[]
  acknowledgedEscalations Escalation[]
  calendar                LawyerCalendar?
  caseHighlights          LawyerCaseHighlight[]

  @@index([tenantId])
  @@map("lawyers")
  @@schema("app")
}

model LawyerCaseHighlight {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @db.Uuid
  lawyerId          String   @db.Uuid
  caseId            String   @db.Uuid
  publicTitle       String
  publicOutcome     String
  consentRecordedAt DateTime @db.Timestamptz(6)
  visibleToAi       Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  lawyer Lawyer @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([lawyerId, caseId])
  @@index([tenantId, lawyerId])
  @@map("lawyer_case_highlights")
  @@schema("app")
}

model LawyerCalendar {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @db.Uuid
  lawyerId            String   @unique @db.Uuid
  googleRefreshTokenEnc String
  googleCalendarId    String   @default("primary")
  connectedAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  lawyer Lawyer @relation(fields: [lawyerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("lawyer_calendars")
  @@schema("app")
}

model LawyerAvailability {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String @db.Uuid
  lawyerId          String @db.Uuid
  weekday           Int // 0=Sunday … 6=Saturday
  startTime         String // "09:00" local firm time (timezone in tenant settings)
  endTime           String
  slotDurationMinutes Int @default(30)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  lawyer Lawyer @relation(fields: [lawyerId], references: [id], onDelete: Cascade)

  @@unique([lawyerId, weekday, startTime])
  @@index([tenantId])
  @@map("lawyer_availability")
  @@schema("app")
}

model Client {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @db.Uuid
  waPhone           String // E.164 — the client's identity on WhatsApp
  name              String?
  cnic              String? // optional PK national ID (D-110)
  preferredLanguage Language  @default(UNKNOWN)
  notes             String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  cases         Case[]
  conversations Conversation[]
  documents     Document[]
  appointments  Appointment[]
  payments      Payment[]

  @@unique([tenantId, waPhone])
  @@map("clients")
  @@schema("app")
}

model Case {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @db.Uuid
  clientId    String       @db.Uuid
  reference   String // firm-scoped human ref, e.g. "FAM-2026-0142"
  matterType  String // from tenant's enabled practice areas (settings jsonb)
  status      CaseStatus   @default(LEAD)
  urgency     Urgency      @default(NORMAL)
  summary     String? // latest AI handoff summary (FR-AI-08)
  intakeData  Json         @default("{}") // canonical English extraction (D-004)
  openedAt    DateTime     @default(now()) @db.Timestamptz(6)
  closedAt    DateTime?    @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  client        Client            @relation(fields: [clientId], references: [id])
  caseLawyers   CaseLawyer[]
  conversations Conversation[]
  documents     Document[]
  appointments  Appointment[]
  payments      Payment[]
  caseHighlights LawyerCaseHighlight[]
  courtHearings  CourtHearing[]

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@map("cases")
  @@schema("app")
}

model CaseLawyer {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @db.Uuid
  caseId     String   @db.Uuid
  lawyerId   String   @db.Uuid
  role       String   @default("primary") // primary | assisting
  assignedAt DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  lawyer Lawyer @relation(fields: [lawyerId], references: [id])

  @@unique([caseId, lawyerId, role])
  @@index([tenantId, lawyerId])
  @@map("case_lawyers")
  @@schema("app")
}

model Conversation {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String            @db.Uuid
  clientId              String            @db.Uuid
  caseId                String?           @db.Uuid
  assignedToId          String?           @db.Uuid
  state                 ConversationState @default(AI_ACTIVE)
  language              Language          @default(UNKNOWN)
  // D-003: the 24h window, tracked explicitly; null = no open window
  sessionWindowExpiresAt DateTime?        @db.Timestamptz(6)
  // FR-AI-01 consent artifact: when the AI disclosure was sent
  disclosedAt           DateTime?         @db.Timestamptz(6)
  lastClientMessageAt   DateTime?         @db.Timestamptz(6)
  lastOutboundAt        DateTime?         @db.Timestamptz(6)
  createdAt             DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  client         Client          @relation(fields: [clientId], references: [id])
  case           Case?           @relation(fields: [caseId], references: [id])
  assignedTo     User?           @relation(fields: [assignedToId], references: [id])
  messages       Message[]
  intakeSessions IntakeSession[]
  escalations    Escalation[]
  notes          ConversationNote[]
  voiceCalls     VoiceCall[]

  @@index([tenantId, state])
  @@index([tenantId, assignedToId])
  @@index([tenantId, clientId])
  @@map("conversations")
  @@schema("app")
}

model VoiceCall {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                @db.Uuid
  conversationId  String                @db.Uuid
  providerCallId  String
  fromWaPhone     String
  instanceName    String
  status          VoiceCallStatus       @default(RINGING)
  disposition     VoiceCallDisposition?
  summary         String?
  transcriptPath  String?
  inboxMessageId  String?               @db.Uuid
  appointmentId   String?               @db.Uuid
  escalationId    String?               @db.Uuid
  startedAt       DateTime              @default(now()) @db.Timestamptz(6)
  answeredAt      DateTime?             @db.Timestamptz(6)
  endedAt         DateTime?             @db.Timestamptz(6)
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([tenantId, providerCallId])
  @@index([tenantId, conversationId])
  @@index([tenantId, status])
  @@map("voice_calls")
  @@schema("app")
}

// PARTITIONED monthly by createdAt (migration 0003). Composite @@id because PG
// requires the partition key in the PK. Note: no unique constraint on wamid —
// PG requires partition key in uniques; inbound idempotency is anchored by
// platform.webhook_events.externalEventId instead.
model Message {
  id               String          @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String          @db.Uuid
  conversationId   String          @db.Uuid
  direction        MessageDirection
  senderType       SenderType
  senderUserId     String?         @db.Uuid // set when a firm user sent it
  wamid            String? // Meta message id
  contentType      ContentType     @default(TEXT)
  body             String? // raw text always preserved (D-004)
  languageDetected Language        @default(UNKNOWN)
  // media refs, location payloads, interactive replies — structured, not text
  payload          Json            @default("{}")
  templateName     String?
  deliveryStatus   DeliveryStatus  @default(QUEUED)
  // FR-KB-03: FAQ citations [{kbId, chunkId, title}]
  citations        Json            @default("[]")
  correlationId    String?         @db.Uuid
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])
  senderUser   User?        @relation(fields: [senderUserId], references: [id])

  @@id([id, createdAt])
  @@index([conversationId, createdAt])
  @@index([tenantId, createdAt])
  @@index([wamid])
  @@map("messages")
  @@schema("app")
}

