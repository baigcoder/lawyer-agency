model Payment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String        @db.Uuid
  caseId         String?       @db.Uuid
  clientId       String        @db.Uuid
  amountCents    Int // PKR paisa; integer money, never float
  currency       String        @default("PKR") @db.Char(3)
  method         PaymentMethod
  status         PaymentStatus @default(REQUESTED)
  // provider transaction id — idempotency key for rail webhooks (FR-PAY-02);
  // null for manual entries (unique index is NULLS-distinct, set in 0002)
  providerTxnId  String?
  description    String?
  requestedAt    DateTime      @default(now()) @db.Timestamptz(6)
  paidAt         DateTime?     @db.Timestamptz(6)
  recordedBy     String?       @db.Uuid // staff attribution for manual (FR-PAY-03)
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  case   Case?  @relation(fields: [caseId], references: [id])
  client Client @relation(fields: [clientId], references: [id])
  recordedByUser User? @relation(fields: [recordedBy], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, caseId])
  @@map("payments")
  @@schema("app")
}

