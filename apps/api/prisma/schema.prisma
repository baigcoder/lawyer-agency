model PilotSession {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String             @unique @db.Uuid
  status          PilotSessionStatus @default(PAIRING)
  // E.164 numbers (no '+') allowed to talk to the pilot bridge (D-092).
  allowlist       Json               @default("[]")
  // AES-256-GCM ciphertext of Baileys session creds (same CryptoService).
  sessionCredsEnc String?
  expiresAt       DateTime           @db.Timestamptz(6)
  lastSeenAt      DateTime?          @db.Timestamptz(6)
  // Last terminal failure reason (handshake exhausted, logged out) — shown
