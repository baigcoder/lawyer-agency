# Environment template for Wakeel.
# See docs/ENV_SETUP.md for step-by-step instructions on how to get every key.

# --- Core (required; validated at boot, fail-fast) ---
NODE_ENV=development
API_PORT=3001
API_ROLE=api            # api | worker (D-013)

# PostgreSQL — app connects as NON-OWNER role `app_user` (ADR-002)
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/lawyer_agency
# Owner role used only by prisma migrate (RLS bypass via FORCE is explicit)
MIGRATION_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/lawyer_agency
# Scratch DB used by `prisma migrate dev` only (never the app, never prod data)
SHADOW_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/lawyer_agency_shadow

REDIS_URL=redis://localhost:6379

# Clerk (D-017)
CLERK_SECRET_KEY=sk_test_replace
CLERK_PUBLISHABLE_KEY=pk_test_replace
# Public dashboard origin used in Clerk organization invitation links (Team page)
APP_PUBLIC_URL=http://localhost:3002

# Field-level encryption for per-tenant secrets (WhatsApp tokens) — 32-byte hex
MASTER_ENCRYPTION_KEY=replace-with-64-hex-chars

# --- External providers (per D-005 allow-list; per-tenant overrides in DB) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Voice — Groq chat key works for Whisper STT (whisper-large-v3-turbo) automatically.
# ElevenLabs TTS for AI voice-note replies. Override STT with OPENAI_WHISPER_* if needed.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_MALE=
ELEVENLABS_VOICE_ID_FEMALE=
# OPENAI_WHISPER_API_KEY=
# OPENAI_WHISPER_BASE_URL=https://api.openai.com/v1
# OPENAI_WHISPER_MODEL=whisper-1

ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# AI model routing defaults (Phase 7). Default model is Groq's openai/gpt-oss-20b
# (fast, free-tier) — replaces groq/llama-3.3-70b-versatile, deprecated 2026-08-16.
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=openai/gpt-oss-20b

# Embeddings (Phase 8) — requires a real OpenAI API key at OPENAI_EMBEDDING_BASE_URL.
# Groq does NOT support embedding models; if chat uses Groq (OPENAI_BASE_URL above),
# leave OPENAI_EMBEDDING_BASE_URL on api.openai.com with a separate OpenAI key, or
# omit it — the retriever falls back to keyword search and AI replies still work.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSIONS=1536

GOOGLE_DOCUMENT_AI_PROJECT=
GOOGLE_DOCUMENT_AI_LOCATION=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=

# Google Calendar OAuth (Phase 3) — optional in dev; required for lawyer calendar sync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/v1/appointments/calendar/callback
GOOGLE_CALENDAR_REMINDER_MINUTES=60

# Evolution API — third-party WhatsApp transport (replaces pilot bridge + official Meta)
EVOLUTION_API_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=evolution-api-key-change-me
# Public URL Evolution uses to call Wakeel webhooks (must be reachable from Evolution container)
EVOLUTION_SERVER_URL=http://localhost:3001
EVOLUTION_DATABASE_URL=postgresql://postgres:change-me@localhost:5433/evolution_api
EVOLUTION_REDIS_URL=redis://localhost:6380
EVOLUTION_WEBHOOK_SECRET=replace-with-random-string

# Legacy WhatsApp providers — DEPRECATED, kept empty for migration only
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_BASE_URL=
META_REDIRECT_URI=
PILOT_BRIDGE_ENABLED=false
PILOT_SESSION_TTL_HOURS=168
PILOT_MAX_ALLOWLIST=25
PILOT_QR_TTL_MINUTES=10

# Local media storage for dev (filesystem stand-in; production uses Supabase/S3)
MEDIA_STORAGE_PATH=/tmp/opencode/wakeel-media

# Supabase Storage — object storage ONLY (Postgres=our DB, Auth=Clerk)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=tenant-documents
# auto = Supabase when configured, local filesystem fallback if bucket upload fails (dev-friendly)
OBJECT_STORAGE_DRIVER=auto

# Observability (D-016)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# Email (optional) — payment receipts + staff digests. Bare address only (not "Name <email>").
# Port 465 = implicit TLS; 587 = STARTTLS.
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# --- Frontend (apps/web) ---
# Server-side: where Next rewrites proxy /backend/* (never exposed to browser)
API_INTERNAL_URL=http://localhost:3001
# Public (build-inlined; never secrets):
NEXT_PUBLIC_API_BASE=/backend
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Dev seam only (D-037): tenant header when Clerk keys are absent
NEXT_PUBLIC_DEV_TENANT_ID=018f3d6e-7c8b-7a2c-9d4e-5f6a7b8c9d0e
