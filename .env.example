# Environment template for Wakeel.
# See docs/ENV_SETUP.md for step-by-step instructions on how to get every key.

# --- Core (required; validated at boot, fail-fast) ---
NODE_ENV=development
API_PORT=3001
API_ROLE=api            # api | worker | voice (D-013 / D-124)

# PostgreSQL — app connects as NON-OWNER role `app_user` (ADR-002)
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/lawyer_agency
# Owner role used only by prisma migrate (RLS bypass via FORCE is explicit)
MIGRATION_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/lawyer_agency
# Scratch DB used by `prisma migrate dev` only (never the app, never prod data)
SHADOW_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/lawyer_agency_shadow

REDIS_URL=redis://localhost:6379

# Clerk (D-017)
CLERK_SECRET_KEY=sk_test_replace
CLERK_PUBLISHABLE_KEY=pk_test_replace
# Public dashboard origin used in Clerk organization invitation links (Team page)
APP_PUBLIC_URL=http://localhost:3002

# Field-level encryption for per-tenant secrets (WhatsApp tokens) — 32-byte hex
MASTER_ENCRYPTION_KEY=replace-with-64-hex-chars

# Groq — preferred for fast WhatsApp chat + Whisper STT when set.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Voice — ElevenLabs Scribe STT + ElevenLabs TTS. Groq Whisper is the STT fallback.
# The API key needs the `voices_read` permission, or the dashboard voice picker
# cannot list your library and silently shows the built-in English voices only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_MALE=
ELEVENLABS_VOICE_ID_FEMALE=
# Urdu replies use their own voice. The English stock voices pronounce Urdu with
# an anglophone accent; a Hindi or Urdu voice sounds native to a Pakistani client
# (Hindi and Urdu are the same spoken language, written in different scripts).
ELEVENLABS_VOICE_ID_URDU_MALE=
ELEVENLABS_VOICE_ID_URDU_FEMALE=
# Which model speaks Urdu notes. eleven_v3 has explicit Urdu support but is slow
# (~6.2s per note measured); eleven_turbo_v2_5 is ~0.7s and infers Urdu from the
# script. Listen to both before switching.
# ELEVENLABS_URDU_NOTE_MODEL=eleven_v3
# OPENAI_WHISPER_API_KEY=
# OPENAI_WHISPER_BASE_URL=https://api.openai.com/v1
# OPENAI_WHISPER_MODEL=whisper-1

# Live WhatsApp Cloud Calling (D-124). The voice container publishes this UDP
# range so Meta can reach ICE candidates. Optional TURN if STUN is blocked.
# WEBRTC_ICE_PORT_MIN=40000
# WEBRTC_ICE_PORT_MAX=40031
# WEBRTC_TURN_URL=
# WEBRTC_TURN_USERNAME=
# WEBRTC_TURN_CREDENTIAL=
#
# QR/Baileys live calls (D-124): Evolution relays CB:call to Wavoip when set.
# The voice process REGISTERs this token as a SIP trunk (user = password = CallerID)
# at sipv2.wavoip.com and answers G.711 PCMU. Without SIP/token, QR calls get a
# missed-call WhatsApp follow-up. Publish 5060/udp + the ICE/RTP UDP range.
# Wavoip QR live calls (D-124). Device token goes to Evolution; SIP user/password
# come from the Wavoip device panel (Integrações → SIP), not the device token.
# WAVOIP_SIP_CONTACT_HOST must be your public IP; router must forward TCP/UDP
# 5060 and UDP 40000-40031 to this machine.
# WAVOIP_TOKEN=
# WAVOIP_SIP_HOST=sipv2.wavoip.com
# WAVOIP_SIP_PORT=5060
# WAVOIP_SIP_USER=
# WAVOIP_SIP_PASSWORD=
# WAVOIP_SIP_CONTACT_HOST=

ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# AI model routing defaults. Conversation agents use Groq openai/gpt-oss-120b;
# the router stays on gpt-oss-20b for speed. Override with AI_DEFAULT_MODEL.
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=openai/gpt-oss-20b

# Embeddings — run locally, no API key. The `embeddings` compose service serves
# multilingual-e5-small (Urdu, Roman Urdu, English) on an OpenAI-compatible route.
# Groq has no embeddings API, and client documents (T3) must not leave for a third
# party by default (D-005). Inside Docker these are overridden to the service name.
OPENAI_EMBEDDING_MODEL=intfloat/multilingual-e5-small
OPENAI_EMBEDDING_BASE_URL=http://localhost:8081/v1
EMBEDDING_DIMENSIONS=384
# Only for a hosted provider. To use OpenAI instead: set the base URL to
# https://api.openai.com/v1, the model to text-embedding-3-small, keep 384 dims,
# and put an OpenAI key (sk-...) here — a Groq key (gsk_...) cannot embed.
OPENAI_EMBEDDING_API_KEY=

GOOGLE_DOCUMENT_AI_PROJECT=
GOOGLE_DOCUMENT_AI_LOCATION=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=

# Google Calendar OAuth (Phase 3) — optional in dev; required for lawyer calendar sync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/v1/appointments/calendar/callback
GOOGLE_CALENDAR_REMINDER_MINUTES=60

# Evolution API — third-party WhatsApp transport (replaces pilot bridge + official Meta)
EVOLUTION_API_BASE_URL=http://localhost:8080
# Generate one: openssl rand -hex 16 . Must match AUTHENTICATION_API_KEY in docker-compose.
EVOLUTION_API_KEY=
# Public URL Evolution uses to call Wakeel webhooks (must be reachable from Evolution container)
EVOLUTION_SERVER_URL=http://localhost:3001
EVOLUTION_DATABASE_URL=postgresql://postgres:change-me@localhost:5433/evolution_api
EVOLUTION_REDIS_URL=redis://localhost:6380
EVOLUTION_WEBHOOK_SECRET=replace-with-random-string

# Legacy WhatsApp providers — DEPRECATED, kept empty for migration only
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_BASE_URL=
META_REDIRECT_URI=
PILOT_BRIDGE_ENABLED=false
PILOT_SESSION_TTL_HOURS=168
PILOT_MAX_ALLOWLIST=25
PILOT_QR_TTL_MINUTES=10

# Local media storage for dev (filesystem stand-in; production uses Supabase/S3)
MEDIA_STORAGE_PATH=/tmp/opencode/wakeel-media

# Supabase Storage — object storage ONLY (Postgres=our DB, Auth=Clerk)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=tenant-documents
# auto = Supabase when configured, local filesystem fallback if bucket upload fails (dev-friendly)
OBJECT_STORAGE_DRIVER=auto

# Observability (D-016)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# Email (optional) — payment receipts + staff digests. Bare address only (not "Name <email>").
# Port 465 = implicit TLS; 587 = STARTTLS.
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# --- Frontend (apps/web) ---
# Server-side: where Next rewrites proxy /backend/* (never exposed to browser)
API_INTERNAL_URL=http://localhost:3001
# Public (build-inlined; never secrets):
NEXT_PUBLIC_API_BASE=/backend
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Dev seam only (D-037): tenant header when Clerk keys are absent
NEXT_PUBLIC_DEV_TENANT_ID=018f3d6e-7c8b-7a2c-9d4e-5f6a7b8c9d0e
# Dev seam only: the seeded dev owner, sent as x-user-id. The dashboard's
# "me" endpoints (profile, user menu) answer 401 without it.
NEXT_PUBLIC_DEV_USER_ID=018f3d6e-7c8b-7a2c-9d4e-5f6a7b8c9d11
# Shown on the privacy/terms/data-deletion pages. Optional — src/lib/env.ts
# supplies defaults. Baked into the bundle at build time, so set them before
# building the web image, not after.
# NEXT_PUBLIC_LEGAL_BUSINESS_NAME=
# NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
