# App config for api/worker/voice on the AWS host. infra/aws/setup.sh copies
# this to .env.app (git-ignored) and fills the generated secrets. Values for
# DATABASE_URL, REDIS_URL, EVOLUTION_* URLs and embeddings come from
# docker-compose.aws.yml — do not set them here.
# Key-by-key acquisition guide: docs/ENV_SETUP.md

# --- Generated by setup.sh (do not change after first boot) -----------------
# Encrypts per-tenant secrets (D-024). Losing it makes stored tokens unreadable.
MASTER_ENCRYPTION_KEY=
EVOLUTION_WEBHOOK_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Required in production: fill these in -----------------------------------
# Clerk dashboard -> API keys (same instance as the Vercel publishable key).
CLERK_SECRET_KEY=
VAPID_SUBJECT=mailto:you@example.com
EMAIL_FROM=you@example.com

# --- AI providers (at least one chat provider) -------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=openai/gpt-oss-20b

# --- Optional -----------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_MALE=
ELEVENLABS_VOICE_ID_FEMALE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
OBJECT_STORAGE_DRIVER=auto
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SENTRY_DSN=
# Live calls (voice profile only)
WAVOIP_TOKEN=
WAVOIP_SIP_CONTACT_HOST=
